# Copy this file to .env and fill in the values. .env is git-ignored.
# Do not commit real credentials.

# ── Anthropic Claude ─────────────────────────────────────────────────────────
# Required. Used by all three orchestrators and by benchmark_profile.py.
ANTHROPIC_API_KEY=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required. Text-to-speech in VideoAgent, embeddings for the semantic cache.
OPENAI_API_KEY=

# ── Google / Gemini (benchmark track only) ───────────────────────────────────
# Used by the reference scripts under examples/.
# Note the Vertex AI SDK itself authenticates via Application Default
# Credentials (`gcloud auth application-default login`), not this key.
GOOGLE_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=asia-southeast1

# ── Semantic prompt cache (optional) ─────────────────────────────────────────
CACHE_ENABLED=1
CACHE_SIM_THRESHOLD=0.78
CACHE_EMBED_MODEL=text-embedding-3-small

# ── Access control ───────────────────────────────────────────────────────────
# Anyone can sign up; being allowed to START A RUN is granted separately,
# because a run calls the Anthropic and OpenAI APIs and costs real money.
#
# Grant it with:  python scripts/grant_access.py --grant someone@example.com
# There is deliberately no HTTP route for granting.
#
# Accounts that may READ the access-request queue at /requests. Comma
# separated. Unset means nobody, which is the safe default -- it must never
# fall open to "everyone".
ADMIN_EMAILS=

# ── CORS and sessions ────────────────────────────────────────────────────────
# Origins allowed to call this API from a browser. Was "*", which combined with
# a bearer token in localStorage meant any site a visitor opened could call it
# with their credentials. Unset defaults to the local front-end.
# CORS_ORIGINS=https://your-app.vercel.app

# How long a sign-in lasts. Sessions previously never expired.
# SESSION_MAX_AGE_DAYS=14

# Key for signing run grants: the short-lived credential that goes in media and
# download URLs, in place of the session token that used to. Whoever holds this
# key can mint a grant for any run id, so treat it like a password.
#
# Unset, a key is generated on first use and kept in .signing_key beside the
# database. That is fine for one process on a laptop. Set it explicitly
# anywhere more than one process serves the app, or they will each sign with a
# different key and every other request will fail.
# SIGNING_SECRET=

# How long a grant lasts. 45 minutes by default, which is longer than it looks
# like it should be for a good reason: a <video> re-requests its URL on every
# seek and EventSource reconnects to it by itself, so a grant shorter than a
# run breaks playback mid-file and streaming mid-run. Floor of 60 seconds.
# GRANT_TTL_SECONDS=2700

# "both" and "all" run every orchestrator in sequence: ~36 minutes and 3x the
# token spend for one click. Off unless this is set to exactly 1.
# ALLOW_FULL_SWEEP=1

# ── Run quotas ───────────────────────────────────────────────────────────────
# Being granted access says an account MAY spend; these say how much. Without
# them a granted demo account can sit in a loop starting runs, each one
# spending Anthropic and OpenAI credits.
#
# The concurrent limit is the one that bites. A caller who waits for each run
# is already limited by the ten minutes a run takes; a caller who does not is
# limited by nothing.
#
# Rolling 24-hour window, counted from the runs table so a restart does not
# hand out a fresh allowance. Cache hits count too: they are recorded as runs
# like any other, and a second definition of "a run" that disagreed with the
# history page would be worse than counting one cheap request.
#
# 0 or less turns a limit off, which is a decision rather than an accident.
# RUN_DAILY_LIMIT=10
# RUN_CONCURRENT_LIMIT=1

# ── Alerts (optional) ────────────────────────────────────────────────────────
# Where to push a notification when somebody asks for access. Any endpoint that
# accepts a JSON POST works: a Discord or Slack incoming webhook, ntfy, or a
# relay that forwards to your email. Unset, requests are still recorded and
# still shown at /requests -- you just have to look.
#
# The alert names the requester and nothing else. What they typed stays in the
# admin view, which renders it as plain text, because chat clients render
# markdown and the request text is untrusted.
# ALERT_WEBHOOK_URL=

# ── Ports (optional) ─────────────────────────────────────────────────────────
# The backend and the Vite proxy read the same variable, so
# `API_PORT=8011 npm run dev` moves both together.
# API_PORT=8010
# WEB_PORT=5273
