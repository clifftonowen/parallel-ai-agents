# Copy this file to .env and fill in the values. .env is git-ignored.
# Do not commit real credentials.

# ── Anthropic Claude ─────────────────────────────────────────────────────────
# Required. Used by all three orchestrators and by benchmark_profile.py.
ANTHROPIC_API_KEY=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required. Text-to-speech in VideoAgent, embeddings for the semantic cache.
OPENAI_API_KEY=

# ── Google / Gemini (benchmark track only) ───────────────────────────────────
# Used by the reference scripts under examples/.
# Note the Vertex AI SDK itself authenticates via Application Default
# Credentials (`gcloud auth application-default login`), not this key.
GOOGLE_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=asia-southeast1

# ── Semantic prompt cache (optional) ─────────────────────────────────────────
CACHE_ENABLED=1
CACHE_SIM_THRESHOLD=0.78
CACHE_EMBED_MODEL=text-embedding-3-small

# ── Access control ───────────────────────────────────────────────────────────
# Anyone can sign up; being allowed to START A RUN is granted separately,
# because a run calls the Anthropic and OpenAI APIs and costs real money.
#
# Grant it with:  python scripts/grant_access.py --grant someone@example.com
# There is deliberately no HTTP route for granting.
#
# Accounts that may READ the access-request queue at /requests. Comma
# separated. Unset means nobody, which is the safe default -- it must never
# fall open to "everyone".
ADMIN_EMAILS=

# ── Alerts (optional) ────────────────────────────────────────────────────────
# Where to push a notification when somebody asks for access. Any endpoint that
# accepts a JSON POST works: a Discord or Slack incoming webhook, ntfy, or a
# relay that forwards to your email. Unset, requests are still recorded and
# still shown at /requests -- you just have to look.
#
# The alert names the requester and nothing else. What they typed stays in the
# admin view, which renders it as plain text, because chat clients render
# markdown and the request text is untrusted.
# ALERT_WEBHOOK_URL=

# ── Ports (optional) ─────────────────────────────────────────────────────────
# The backend and the Vite proxy read the same variable, so
# `API_PORT=8011 npm run dev` moves both together.
# API_PORT=8010
# WEB_PORT=5273
