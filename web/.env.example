# Front-end build configuration. Vite inlines these at BUILD time, not run time,
# so changing one means a rebuild -- on Vercel, a redeploy.
#
# Nothing here is a secret. Anything named VITE_* is compiled into the bundle
# and readable by anyone who opens the page, so never put a key in this file.

# ── Where the API lives ──────────────────────────────────────────────────────
# Unset means /api, which the dev server proxies to the backend on API_PORT.
#
# Deployed, this is the backend's ORIGIN ROOT WITH NO /api SUFFIX. The dev proxy
# strips that prefix and the backend's own routes are unprefixed, so a value
# ending in /api produces a uniform 404 against a completely healthy backend --
# which looks exactly like the backend being down.
#
#   right:  VITE_API_BASE=https://urop-api.fly.dev
#   wrong:  VITE_API_BASE=https://urop-api.fly.dev/api
#
# The backend must also list this app's origin in its own CORS_ORIGINS.
# VITE_API_BASE=https://urop-api.fly.dev

# ── The standalone demo ──────────────────────────────────────────────────────
# "1" builds a version that needs no backend at all: fixtures from one real
# finished run and the committed benchmark numbers are compiled into the
# bundle, and every call that would hit the network answers from src/api/demo.ts
# instead. Sign-in, the composer and the ZIP download explain themselves rather
# than failing.
#
# This is what a static host serves while the backend is not deployed. Unset it
# and set VITE_API_BASE to switch the same code to the live one.
# VITE_DEMO_MODE=1

# ── Contact ──────────────────────────────────────────────────────────────────
# Shown on the landing page and wherever the demo says "get in touch". Unset,
# those point at the GitHub repository instead: publishing an address is a
# decision for whoever owns it, not a default.
# VITE_CONTACT_EMAIL=
